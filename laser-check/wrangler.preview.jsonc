{
  "name": "valida-laser-teste",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valida-laser-teste",
      "database_id": "a9d715f1-531a-4645-b5ab-aca323a7d971"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "valida-laser-teste-fotos"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEGACY_PHOTOS",
      "id": "aceeeb4e31344e2fa6c15e31abf6771d"
    }
  ]
}
